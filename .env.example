# LinkedIn publishing. See docs/LINKEDIN_PUBLISHING.md.
# mock (default) needs none of the others and never talks to LinkedIn.
LINKEDIN_PUBLISHER=mock
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
# 32 random bytes, base64. Encrypts access tokens at rest. Server only; never NEXT_PUBLIC_.
TOKEN_ENCRYPTION_KEY=
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" when it calls the worker.
CRON_SECRET=
