# Supabase. Leave these empty to run on sample data with no sign-in.
# Project Settings → API Keys: the publishable key, and the secret key (server only; never NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Connect → Session pooler, with the database password in it. Used by npm run db:migrate and db:questions.
DATABASE_URL=
# Dev only, without Supabase: set to `new` to start as a brand-new person instead of Maya's sample brain.
SAMPLE_BRAIN=

# LinkedIn publishing. See docs/LINKEDIN_PUBLISHING.md.
# mock (default) needs none of the others and never talks to LinkedIn.
LINKEDIN_PUBLISHER=mock
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
# 32 random bytes, base64. Encrypts access tokens at rest. Server only; never NEXT_PUBLIC_.
TOKEN_ENCRYPTION_KEY=
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" when it calls the worker.
CRON_SECRET=
